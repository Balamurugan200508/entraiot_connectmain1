{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": true,
  "buildCommand": null,
  "installCommand": "echo 'No install needed'",
  "outputDirectory": "dist-vercel",
  "headers": [
    {
      "source": "/(.*)\\.wasm\\.br",
      "headers": [
        { "key": "Content-Encoding", "value": "br" },
        { "key": "Content-Type", "value": "application/wasm" }
      ]
    },
    {
      "source": "/(.*)\\.data\\.br",
      "headers": [
        { "key": "Content-Encoding", "value": "br" },
        { "key": "Content-Type", "value": "application/octet-stream" }
      ]
    },
    {
      "source": "/(.*)\\.js\\.br",
      "headers": [
        { "key": "Content-Encoding", "value": "br" },
        { "key": "Content-Type", "value": "application/javascript" }
      ]
    },
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/eiffel.glb", "destination": "/buildings/eiffel.glb" },
    { "source": "/pond%20scene.glb", "destination": "/buildings/pond scene.glb" },
    { "source": "/pond scene.glb", "destination": "/buildings/pond scene.glb" },
    { "source": "/assets/(.*)", "destination": "/portfolio/assets/$1" },
    { "source": "/gltf/(.*)", "destination": "/portfolio/gltf/$1" },
    { "source": "/image/(.*)", "destination": "/portfolio/image/$1" },
    { "source": "/sounds/(.*)", "destination": "/portfolio/sounds/$1" },
    { "source": "/texture/(.*)", "destination": "/portfolio/texture/$1" },
    { "source": "/vendors/(.*)", "destination": "/portfolio/vendors/$1" },
    { "source": "/hdri/(.*)", "destination": "/portfolio/hdri/$1" },
    { "source": "/portfolio/(.*)", "destination": "/portfolio/$1" },
    { "source": "/portfolio", "destination": "/portfolio/index.html" },
    { "source": "/way/(.*)", "destination": "/way/$1" },
    { "source": "/way", "destination": "/way/index.html" },
    { "source": "/buildings/(.*)", "destination": "/buildings/$1" },
    { "source": "/buildings", "destination": "/buildings/index.html" },
    { "source": "/management/(.*)", "destination": "/management/$1" },
    { "source": "/management", "destination": "/management/index.html" },
    { "source": "/marketing/(.*)", "destination": "/marketing/$1" },
    { "source": "/marketing", "destination": "/marketing/index.html" },
    { "source": "/technical/(.*)", "destination": "/technical/$1" },
    { "source": "/technical", "destination": "/technical/index.html" },
    { "source": "/financial/(.*)", "destination": "/financial/$1" },
    { "source": "/financial", "destination": "/financial/index.html" },
    { "source": "/client-handling/(.*)", "destination": "/client-handling/$1" },
    { "source": "/client-handling", "destination": "/client-handling/index.html" },
    { "source": "/entraiot-ceo-main/(.*)", "destination": "/entraiot-ceo/$1" },
    { "source": "/entraiot-ceo-main", "destination": "/entraiot-ceo/index.html" },
    { "source": "/entraiot-ceo/(.*)", "destination": "/entraiot-ceo/$1" },
    { "source": "/entraiot-ceo", "destination": "/entraiot-ceo/index.html" },
    { "source": "/entraiot-md-main/(.*)", "destination": "/entraiot-md/$1" },
    { "source": "/entraiot-md-main", "destination": "/entraiot-md/index.html" },
    { "source": "/entraiot-md/(.*)", "destination": "/entraiot-md/$1" },
    { "source": "/entraiot-md", "destination": "/entraiot-md/index.html" },
    { "source": "/entraiot-developer/(.*)", "destination": "/entraiot-developer/$1" },
    { "source": "/entraiot-developer", "destination": "/entraiot-developer/index.html" },
    { "source": "/entraiot-developer-2/(.*)", "destination": "/entraiot-developer-2/$1" },
    { "source": "/entraiot-developer-2", "destination": "/entraiot-developer-2/index.html" },
    { "source": "/non-animated-main/(.*)", "destination": "/non-animated/$1" },
    { "source": "/non-animated-main", "destination": "/non-animated/index.html" },
    { "source": "/non-animated/(.*)", "destination": "/non-animated/$1" },
    { "source": "/non-animated", "destination": "/non-animated/index.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
